# FEI XMD — public bot defaults. Keep provider keys and real secrets out of Git.
BOT_NAME=FEI XMD
BOT_VERSION=1.0.0
# Set any non-empty prefix: ., !, !!, fei, #, etc. Quote values containing spaces.\nPREFIX=.
OWNER_NAME=Benfei Tech
# This public build has one configured owner number.
OWNER_NUMBER=2349060715145
BOT_MODE=public
LOG_LEVEL=info

# Official FEI XMD pairing portal and bot menu artwork.
BOT_URL=https://fei-xmd.benfeilab.com
BOT_IMAGE_URL=https://res.cloudinary.com/dqqyvozdw/image/upload/v1792848652/arbeimjfqkkfpn9zvfhf.png

FEI_SESSION_DIR=./auth_info_baileys
FEI_DATA_DIR=./data

# Optional PostgreSQL / Neon connection for future database-backed features.
DATABASE_URL=

# Optional non-interactive pairing number (country code + digits, no + sign).
PAIRING_NUMBER=

# Optional NabeesTech download API key (never commit a live key).
NABEES_API_KEY=
