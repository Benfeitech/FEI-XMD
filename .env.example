# black XMD — public bot defaults. Keep provider keys and real secrets out of Git.
BOT_NAME=black XMD
BOT_VERSION=1.0.0
# Set any non-empty prefix: ., !, !!, black, #, etc. Quote values containing spaces.
PREFIX=.
OWNER_NAME=Benfei Tech
# This public build has one configured owner number.
OWNER_NUMBER=254140757772
BOT_MODE=public
LOG_LEVEL=info

# Official black XMD pairing portal and bot menu artwork.
BOT_URL=https://black-xmd.benfeilab.com
BOT_IMAGE_URL=https://res.cloudinary.com/dqqyvozdw/image/upload/v1792848652/arbeimjfqkkfpn9zvfhf.png

FEI_SESSION_DIR=./auth_info_baileys
FEI_DATA_DIR=./data

# Optional PostgreSQL / Neon connection for future database-backed features.
DATABASE_URL=

# Optional non-interactive pairing number (country code + digits, no + sign).
PAIRING_NUMBER=

